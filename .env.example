# DOCX docker-compose (루트)
# copy → .env 후 docker compose up --build

# PostgreSQL (db 서비스)
POSTGRES_USER=krstock
POSTGRES_PASSWORD=krstockpass
POSTGRES_DB=krstock

# API (FastAPI — 포트 8000)
DATABASE_URL=postgresql+asyncpg://krstock:krstockpass@db:5432/krstock
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-32chars
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
REDIS_URL=redis://localhost:6379/0
INTEGRATIONS_ALLOW_UI_SAVE=false

# 비밀번호 재설정 메일 (운영)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
OAUTH_FRONTEND_BASE=http://localhost:3000
OAUTH_BACKEND_BASE=http://127.0.0.1:8000

# Firebase Web Push (FCM 토큰 자동 발급 — /config/firebase-public)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=

# Web (Next.js — docker compose web 서비스)
# STOCK_API_PROXY: 컨테이너 내부 SSR 프록시 / NEXT_PUBLIC_*: 브라우저(로컬 bat과 동일)
STOCK_API_PROXY=http://api:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/api/v1/ws/stocks

# AI Assistant (OpenAI 또는 Gemini — docker compose api 서비스로 전달)
OPENAI_API_KEY=
GEMINI_API_KEY=
